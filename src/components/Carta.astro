---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Cup from './Cup.astro';
import { menu, compositionText } from '../data/menu';
import { contactAnchor } from '../data/site';
---

<section class="carta" id="carta" data-nav-section aria-labelledby="carta-title">
  <div class="wrap">
    <header class="carta__head">
      <h2 class="title" id="carta-title" data-motion="title">La carta</h2>

      <!-- The key to the menu: one cup drawn at display size, its layers named. -->
      <div class="carta__key" aria-hidden="true">
        <Cup id="cappuccino" size="lg" />
        <ul class="carta__key-labels" role="list">
          <li>Espuma</li>
          <li>Leche</li>
          <li>Espresso</li>
        </ul>
        <p class="carta__key-note notation">Un cappuccino, de abajo arriba.</p>
      </div>
      <div class="carta__intro">
        <p class="lead">
          Cafés, bebidas frías y repostería. Junto a cada bebida, lo que lleva dentro, de abajo
          arriba. Aquí no verás precios: pregúntanos y te los contamos.
        </p>
        <nav class="carta__index" aria-label="Secciones de la carta">
          <ul role="list">
            {
              menu.map((category) => (
                <li>
                  <a href={`#${category.id}`}>{category.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    {
      menu.map((category) => (
        <section class="category" id={category.id} aria-labelledby={`${category.id}-title`}>
          <div class="category__aside">
            <h3 class="category__title" id={`${category.id}-title`}>
              {category.title}
            </h3>
            <p class="category__note">{category.note}</p>
          </div>
          <ul class="category__items" role="list">
            {category.items.map((item) => {
              const inside = compositionText(item.id);
              return (
                <li class="item" id={item.id}>
                  <div class="item__photo photo photo--zoom">
                    <Photo
                      src={item.image}
                      alt={item.alt}
                      widths={[160, 240, 320, 400]}
                      sizes="(min-width: 48rem) 7.5rem, 6rem"
                    />
                  </div>
                  <div class="item__text">
                    <div class="item__head">
                      {inside && <Cup id={item.id} />}
                      <h4 class="item__name">{item.name}</h4>
                      {inside && <p class="item__inside notation">{inside}</p>}
                    </div>
                    <p class="item__desc">{item.description}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <aside class="carta__ask" aria-label="Precios y disponibilidad">
      <p>
        <strong>¿Cuánto cuesta? ¿Queda cheesecake hoy?</strong>
        Los precios y la repostería del día te los contamos por mensaje.
      </p>
      <a class="btn" href={`#${contactAnchor}`}>
        Preguntar por mensaje
        <Icon name="arrow" />
      </a>
    </aside>
  </div>
</section>

<style>
  /* Milk, poured under the foam: the ground eases from one into the other. */
  .carta {
    --ground: var(--milk);
    padding-block: var(--section-y);
    background: linear-gradient(var(--foam), var(--milk) var(--seam)) var(--milk);
  }

  .carta__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 1.5rem;
    align-items: end;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .carta__head .title {
    grid-column: 1 / 6;
    grid-row: 1;
  }

  .carta__intro {
    grid-column: 7 / -1;
    grid-row: 1 / 3;
    display: grid;
    gap: 1.25rem;
  }

  /* The key: a cup at display size with its layers named on hairlines beside it. */
  .carta__key {
    grid-column: 1 / 6;
    grid-row: 2;
    display: grid;
    /* Fixed first column: the note below spans both and must not widen the cup's track. */
    grid-template-columns: 5.5rem minmax(0, 12rem);
    justify-content: start;
    column-gap: 1rem;
    align-items: stretch;
    margin-top: 1rem;
  }

  .carta__key-labels {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    padding-block: 4px;
  }

  .carta__key-labels li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .carta__key-labels li::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .carta__key-note {
    grid-column: 1 / -1;
    margin-top: 0.75rem;
  }

  .carta__index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .carta__index a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration-color: var(--rule-strong);
    transition: text-decoration-color var(--t-quick) ease;
  }

  .carta__index a:hover {
    text-decoration-color: currentColor;
  }

  /* ----- A category: its name holds still on the left while its drinks pass ----- */

  .category {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    padding-block: clamp(2rem, 3.5vw, 3rem);
    border-top: 1px solid var(--rule-strong);
    scroll-margin-top: var(--header-h);
  }

  .category__aside {
    grid-column: 1 / 4;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 0.6rem;
    padding-right: 1rem;
  }

  .category__title {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .category__note {
    max-width: 24ch;
    color: var(--coffee);
  }

  .category__items {
    grid-column: 4 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 3rem);
  }

  .item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .item__photo {
    --mat-w: 0.4rem;
    aspect-ratio: 1;
  }

  /* Pointing at a drink pours its cup again and mounts its photograph. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .item:hover .item__photo :global(img) {
      transform: scale(1.06);
      transition-duration: 1100ms;
    }

    /* Only the top layer is sipped and poured again: the rest of the cup, the information
       being read, never moves. */
    .item:hover :global(.cup__layer:first-child) {
      transform-origin: bottom;
      animation: top-up 900ms linear;
    }
  }

  @media (hover: hover) {
    .item:hover .item__photo::after {
      box-shadow: inset 0 0 0 var(--mat-w) var(--mat);
      transition-duration: 600ms;
    }
  }

  /* Sipped quickly from where it is, then poured slowly: no jump from full to empty. */
  @keyframes top-up {
    0% {
      transform: scaleY(1);
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }
    27% {
      transform: scaleY(0.06);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    100% {
      transform: scaleY(1);
    }
  }

  .item__text {
    display: grid;
    gap: 0.45rem;
  }

  .item__name {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  /* The drink's cup stands beside its name; the ingredient line under the name is its legend. */
  .item__head {
    display: grid;
    gap: 0.2rem;
  }

  .item__head:has(.cup) {
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.85rem;
    align-items: end;
  }

  .item__head > :global(.cup) {
    grid-row: 1 / 3;
  }

  .item__inside {
    line-height: 1.3;
  }

  .item__desc {
    max-width: 42ch;
    font-size: 0.975rem;
    line-height: 1.55;
  }

  /* ----- The menu's last line: the question about prices ----- */

  .carta__ask {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 1.25rem;
    align-items: center;
    padding-top: clamp(2rem, 3.5vw, 3rem);
    border-top: 1px solid var(--rule-strong);
  }

  .carta__ask p {
    grid-column: 4 / 10;
    max-width: 40ch;
  }

  .carta__ask strong {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
  }

  .carta__ask .btn {
    grid-column: 10 / -1;
    justify-self: end;
  }

  @media (max-width: 72rem) {
    .category__items {
      grid-template-columns: minmax(0, 1fr);
    }

    .carta__ask p {
      grid-column: 4 / -1;
    }

    .carta__ask .btn {
      grid-column: 4 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 48rem) {
    .carta__head .title,
    .carta__key,
    .carta__intro,
    .category__aside,
    .category__items,
    .carta__ask p,
    .carta__ask .btn {
      grid-column: 1 / -1;
    }

    .carta__intro {
      grid-row: auto;
    }

    .carta__key {
      grid-row: auto;
      margin-top: 0;
    }

    .category__aside {
      position: static;
      padding: 0 0 1.5rem;
    }

    .carta__index ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
    }

    .item {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 1rem;
    }

    .carta__ask .btn {
      width: 100%;
    }
  }
</style>

---
import Icon from './Icon.astro';
import { contact } from '../data/contact';

// Lets long handles and addresses wrap after the "@" instead of mid-word on narrow phones.
const splitAt = (text: string) => text.split('@');
---

<section class="contacto dark" id="contacto" data-nav-section aria-labelledby="contacto-title">
  <div class="wrap">
    <div class="contacto__grid">
    <!-- The heading's size follows the width of its own column (container units), never the
         viewport, so it cannot grow past that column into the channels. -->
    <header class="contacto__head">
      <h2 class="contacto__title" id="contacto-title" data-motion="chars">Escríbenos</h2>
      <p class="lead">
        ¿Quieres saber precios, qué hay hoy en la vitrina o si podemos preparar algo para tu
        reunión? Pregúntanos por el canal que prefieras y te respondemos.
      </p>
    </header>

    <div class="contacto__channels">
    <ul class="channels" role="list">
      {
        contact.channels.map((channel) => {
          const body = (
            <>
              <Icon name={channel.id} class="channel__icon" />
              <span class="channel__label">{channel.label}</span>
              <span class="channel__handle notation">
                {splitAt(channel.handle).map((part, i) => (
                  <>
                    {i > 0 && (
                      <>
                        @<wbr />
                      </>
                    )}
                    {part}
                  </>
                ))}
              </span>
              <span class="channel__go">
                <span class="visually-hidden">{channel.action}</span>
                <Icon name="arrow" />
              </span>
            </>
          );
          return (
            <li>
              {contact.isDemo || !channel.href ? (
                <button
                  class="channel"
                  type="button"
                  popovertarget="demo-canal"
                  aria-describedby="aviso-canales"
                >
                  {body}
                </button>
              ) : (
                <a
                  class="channel"
                  href={channel.href}
                  {...(channel.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
                >
                  {body}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>

    {
      contact.isDemo && (
        <p class="contacto__demo" id="aviso-canales">
          <Icon name="info" />
          <span>
            Monika's Coffee es una cafetería ficticia creada para un portafolio. Estos canales son de
            ejemplo y no reciben mensajes.
          </span>
        </p>
      )
    }
    </div>
    </div>
  </div>

  {
    contact.isDemo && (
      <div class="demo-note" id="demo-canal" popover aria-labelledby="demo-canal-title">
        <h3 class="demo-note__title" id="demo-canal-title">
          Canal de demostración
        </h3>
        <p>
          Monika's Coffee no existe fuera de esta web: es una marca ficticia creada como proyecto de
          portafolio, así que este canal no está activo y nadie recibirá tu mensaje.
        </p>
        <p>
          En la web de una cafetería real, este botón abriría WhatsApp, Instagram o tu correo con la
          conversación lista para escribir.
        </p>
        <button class="btn" type="button" popovertarget="demo-canal" popovertargetaction="hide">
          Entendido
        </button>
      </div>
    )
  }
</section>

<style>
  .contacto {
    padding-block: 0 var(--section-y);
  }

  .contacto .wrap {
    padding-top: var(--section-y);
    border-top: 1px solid var(--rule);
  }

  .contacto__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contacto__head {
    container-type: inline-size;
    display: grid;
    gap: 1.5rem;
  }

  .contacto__title {
    font-size: clamp(2.75rem, 17cqi, 6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  /* ----- Three channels as ruled lines, the same device as the house notes ----- */

  /* The rules are strokes (scaled by --rule) so the motion script can write them in. */
  .channels {
    position: relative;
  }

  .channels::before,
  .channels li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: left;
    pointer-events: none;
  }

  .channels::before {
    top: 0;
    background: rgb(243 233 220 / 0.35);
    transform: scaleX(var(--rule-top, 1));
  }

  .channels li {
    position: relative;
  }

  .channels li::after {
    bottom: 0;
    background: var(--rule);
    transform: scaleX(var(--rule, 1));
  }

  .channel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'icon label go'
      'icon handle go';
    align-items: center;
    gap: 0.2rem 1.25rem;
    width: 100%;
    min-height: 7rem;
    padding: 1.25rem 0;
    border: 0;
    background: none;
    color: var(--on-dark);
    text-align: left;
    text-decoration: none;
  }

  .channel__icon {
    grid-area: icon;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--caramel);
  }

  .channel__label {
    grid-area: label;
    align-self: end;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    transition: color var(--t-quick) ease;
  }

  .channel__handle {
    grid-area: handle;
    align-self: start;
    overflow-wrap: anywhere;
  }

  .channel__go {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    grid-area: go;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--caramel);
    color: var(--espresso);
    transition: scale 420ms var(--ease-bounce);
  }

  /* The disc is poured full of a lighter caramel, like the buttons. */
  .channel__go::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #e3c8a4;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  /* A caramel rule is written under the row, and erased towards the right on the way out. */
  .channel::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--caramel);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .channel:hover .channel__label {
    color: var(--caramel);
  }

  .channel:hover .channel__go::before,
  .channel:hover::after {
    opacity: 1;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .channel__label {
      transition:
        color var(--t-quick) ease,
        transform 600ms var(--ease-out);
    }

    .channel:hover .channel__label {
      transform: translateX(0.4rem);
    }

    .channel__go::before {
      opacity: 1;
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform var(--t-pour) var(--ease-pour);
    }

    .channel:hover .channel__go::before {
      transform: scaleY(1);
    }

    .channel:hover .channel__go .icon {
      animation: arrow-through 560ms var(--ease-out);
    }

    .channel::after {
      opacity: 1;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 320ms var(--ease-out);
    }

    .channel:hover::after {
      transform: scaleX(1);
      transform-origin: left;
      transition-duration: 700ms;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Pressed, the disc gives under the finger (scale, so it composes with the magnet). */
    .channel:active .channel__go {
      scale: 0.88;
      transition: scale var(--t-press) var(--ease-in);
    }
  }

  .contacto__demo {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    max-width: 60ch;
    margin-top: 1.5rem;
    font-size: var(--step--1);
  }

  .contacto__demo .icon {
    margin-top: 0.1rem;
    color: var(--caramel);
  }

  /* ----- The demonstration notice: a card set on the dimmed room ----- */

  .demo-note {
    --focus: #8a5a2b;
    position: fixed;
    inset: 0;
    width: min(100% - 2rem, 30rem);
    height: fit-content;
    margin: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 0;
    border-radius: 6px;
    background: var(--milk);
    color: var(--brown);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  /* Only the display switches with the open state; the spacing belongs to the notice itself,
     so it holds while the notice leaves. */
  .demo-note {
    gap: 1rem;
  }

  .demo-note:popover-open {
    display: grid;
  }

  /* Enter and leave: the notice fades (and, with motion, rises) in 380ms and leaves in 200ms. */
  /* The card turns opaque fast (180ms in, 150ms out) so it never shows two texts at once;
     only its rise takes longer. */
  .demo-note {
    opacity: 0;
    transition:
      opacity 150ms ease,
      transform 200ms var(--ease-out),
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  .demo-note:popover-open {
    opacity: 1;
    transition-duration: 180ms, 380ms, 380ms, 380ms;
    transition-timing-function: var(--ease-out);
  }

  @starting-style {
    .demo-note:popover-open {
      opacity: 0;
    }
  }

  /* Reduced motion re-indexes the transition lists, so give the notice one duration per state:
     a 180ms fade in and a 150ms fade out, nothing else. */
  @media (prefers-reduced-motion: reduce) {
    .demo-note {
      transition-duration: 150ms;
    }

    .demo-note:popover-open {
      transition-duration: 180ms;
    }
  }

  .demo-note::backdrop {
    background: rgb(26 17 13 / 0);
    transition:
      background-color 260ms ease,
      overlay 260ms allow-discrete,
      display 260ms allow-discrete;
  }

  .demo-note:popover-open::backdrop {
    background: rgb(26 17 13 / 0.6);
  }

  @starting-style {
    .demo-note:popover-open::backdrop {
      background: rgb(26 17 13 / 0);
    }
  }

  .demo-note__title {
    font-size: var(--step-2);
    color: var(--ink);
  }

  .demo-note .btn {
    --btn-bg: var(--ink);
    --btn-fg: var(--foam);
    --btn-bg-hover: #4a3026;
    justify-self: start;
    margin-top: 0.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .demo-note {
      transform: translateY(0.5rem) scale(0.98);
    }

    .demo-note:popover-open {
      transform: none;
    }

    @starting-style {
      .demo-note:popover-open {
        transform: translateY(0.75rem) scale(0.98);
      }
    }
  }

  @media (max-width: 60rem) {
    .contacto__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .contacto__head {
      max-width: 40rem;
    }

    .channel {
      min-height: 5.5rem;
      column-gap: 1rem;
    }

    .channel__label {
      font-size: var(--step-2);
    }

    .channel__go {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>

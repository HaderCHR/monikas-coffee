---
// The cup in section: a small glass drawn in layers of what goes into a drink, bottom to top.
// Decorative (the same information is written next to it as text), so it is hidden from
// assistive technology.
import { composition } from '../data/menu';

interface Props {
  id: string;
  /** "lg" draws the cup at display size, for the menu's key. */
  size?: 'md' | 'lg';
}

const { id, size = 'md' } = Astro.props;
const layers = composition[id] ?? [];
---

{
  layers.length > 0 && (
    <span class:list={['cup', `cup--${size}`]} aria-hidden="true">
      <span class="cup__fill">
      {[...layers].reverse().map(([layer, share]) => (
        <span class={`cup__layer cup__layer--${layer}`} data-share={share} />
      ))}
      </span>
    </span>
  )
}

<style>
  .cup {
    display: inline-flex;
    flex-direction: column;
    flex: none;
    width: 2rem;
    height: 2.85rem;
    padding: 2px;
    border: 1.5px solid var(--rule-strong);
    border-top: 0;
    border-radius: 0 0 0.55rem 0.55rem;
    overflow: hidden;
  }

  .cup--lg {
    width: 5.5rem;
    height: 7.5rem;
    padding: 4px;
    border-width: 2px;
    border-radius: 0 0 1.4rem 1.4rem;
  }

  .cup--lg .cup__layer + .cup__layer {
    margin-top: 3px;
  }

  .cup--lg .cup__layer:last-child {
    border-radius: 0 0 1.1rem 1.1rem;
  }

  .cup__fill {
    display: flex;
    flex-direction: column;
    height: 100%;
    transform-origin: bottom;
  }

  .cup__layer {
    display: block;
    flex: 1 1 0;
    min-height: 2px;
  }

  .cup__layer[data-share='2'] {
    flex-grow: 2;
  }

  .cup__layer[data-share='3'] {
    flex-grow: 3;
  }

  .cup__layer + .cup__layer {
    margin-top: 1px;
  }

  .cup__layer:first-child {
    border-radius: 1px 1px 0 0;
  }

  .cup__layer:last-child {
    border-radius: 0 0 0.4rem 0.4rem;
  }

  .cup__layer--espresso { background: #3b2417; }
  .cup__layer--agua { background: #a9784f; }
  .cup__layer--leche { background: #eadbc6; }
  .cup__layer--espuma { background: #fffcf6; box-shadow: inset 0 0 0 1px rgb(74 48 38 / 0.18); }
  .cup__layer--chocolate { background: #50301f; }
  .cup__layer--nata { background: #fff8ec; box-shadow: inset 0 0 0 1px rgb(74 48 38 / 0.18); }
  .cup__layer--vainilla { background: #e6d29b; }
  .cup__layer--caramelo { background: #c27f3e; }
  .cup__layer--hielo { background: repeating-linear-gradient(135deg, #e3ebec 0 3px, #f6f9f9 3px 6px); }
  .cup__layer--matcha { background: #8fa25a; }
  .cup__layer--te { background: #b0404b; }
  .cup__layer--frutos { background: #6e1f35; }

</style>

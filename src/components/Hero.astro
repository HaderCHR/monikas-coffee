---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { contactAnchor } from '../data/site';
import sala from '../assets/photos/casa-sala.jpg';
---

<section class="hero" id="inicio" data-nav-section aria-labelledby="hero-title">
  <div class="hero__grid wrap">
    <div class="hero__photo photo">
      <Photo
        src={sala}
        alt="La sala con luz de tarde: mesas de madera, sillas de bistró y plantas colgantes."
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        priority
      />
    </div>

    <!-- The house recipe card, set down over the photograph. -->
    <div class="hero__card">
      <h1 class="hero__title" id="hero-title">
        <span class="visually-hidden">Monika's Coffee: </span>Café recién hecho y repostería de casa,
        para quedarse un rato.
      </h1>
      <p class="hero__text">
        Una cafetería pequeña para sentarse sin prisa: espressos y lattes preparados al momento,
        bebidas frías, matcha y bollería del día.
      </p>
      <div class="hero__actions">
        <a class="btn" href={`#${contactAnchor}`}>
          Escríbenos
          <Icon name="arrow" />
        </a>
        <a class="text-link" href="#carta">Ver la carta</a>
      </div>
    </div>

    <!-- The recipe's three measurements, written on a ruled line like the foot of a card. -->
    <div class="hero__notes">
      <dl>
        <div>
          <dt>Molido</dt>
          <dd>18 g</dd>
        </div>
        <div>
          <dt>Extracción</dt>
          <dd>25 s</dd>
        </div>
        <div>
          <dt>Leche</dt>
          <dd>65 °C</dd>
        </div>
      </dl>
      <a class="text-link" href="#ritual">
        Cómo preparamos cada taza
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    --photo-h: clamp(22rem, 64svh, 44rem);
    --overlap: clamp(9rem, 22svh, 15rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: calc(var(--photo-h) - var(--overlap)) var(--overlap) auto;
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  /* The photograph runs the full width of the page and out to the window's right edge. */
  .hero__photo {
    grid-column: 1 / -1;
    grid-row: 1 / 3;
    margin-right: calc(-1 * var(--gutter));
    margin-top: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  /* The light falls on the tables and chairs: keep them in the crop. */
  .hero__photo :global(img) {
    object-position: 50% 78%;
  }

  .hero__card {
    position: relative;
    grid-column: 1 / 8;
    grid-row: 2 / 4;
    align-self: start;
    display: grid;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    padding: clamp(1.75rem, 3.2vw, 3rem);
    background: var(--milk);
    border-radius: 4px;
    box-shadow:
      0 1px 0 rgb(74 48 38 / 0.08),
      0 28px 56px -32px rgb(36 24 18 / 0.45);
  }

  .hero__title {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 17ch;
  }

  .hero__text {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero__notes {
    grid-column: 8 / -1;
    grid-row: 3;
    align-self: start;
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vw, 2.75rem);
  }

  .hero__notes dl {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }

  /* The two rules of the line, drawn as their own strokes so the entrance can write them. */
  .hero__notes dl::before,
  .hero__notes dl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule-strong);
    transform-origin: left;
  }

  .hero__notes dl::before {
    top: 0;
  }

  .hero__notes dl::after {
    bottom: 0;
  }

  .hero__notes dl > div {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 0 0.9rem;
  }

  .hero__notes dl > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .hero__notes dt {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--coffee);
  }

  .hero__notes dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--ink);
    font-variant-numeric: lining-nums;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  /* ----- The one authored entrance: the room is poured in from the bottom, then the card
     is set down on it. Everything starts visible without it. ----- */

  @media (prefers-reduced-motion: no-preference) {
    .hero__photo {
      animation: pour-in 1100ms var(--ease-out) 80ms backwards;
    }

    .hero__photo :global(img) {
      animation: settle 1700ms var(--ease-out) 80ms backwards;
    }

    /* The card stays opaque: it is set down, never faded in over the photograph. */
    .hero__card {
      animation: set-down 900ms var(--ease-out) 250ms backwards;
    }

    /* Then the measurements are written on their ruled line: two strokes, three values. */
    .hero__notes dl::before {
      animation: write 900ms var(--ease-out) 620ms backwards;
    }

    .hero__notes dl::after {
      animation: write 900ms var(--ease-out) 720ms backwards;
    }

    .hero__notes dd {
      animation: rise 700ms var(--ease-out) 820ms backwards;
    }

    .hero__notes dl > div:nth-child(2) dd {
      animation-delay: 890ms;
    }

    .hero__notes dl > div:nth-child(3) dd {
      animation-delay: 960ms;
    }
  }

  @keyframes pour-in {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes write {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
  }

  @keyframes set-down {
    from {
      transform: translateY(1.75rem);
    }
  }

  /* ----- Tablet: the card takes more of the width ----- */

  @media (max-width: 64rem) {
    .hero__notes {
      grid-column: 1 / -1;
      grid-row: 4;
      max-width: 34rem;
    }

    .hero__card {
      grid-column: 1 / 10;
    }
  }

  /* ----- Phones: the photograph runs edge to edge, the card overlaps its foot ----- */

  @media (max-width: 48rem) {
    .hero {
      --photo-h: clamp(17rem, 50svh, 26rem);
      --overlap: 3.5rem;
    }

    .hero__photo {
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--gutter));
      margin-top: 0;
    }

    .hero__card {
      grid-column: 1 / -1;
      margin-inline: -0.25rem;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__actions .text-link {
      margin-inline: auto;
    }
  }

  /* Small phones: a shorter photograph keeps "Escríbenos" in the first screen. */
  @media (max-width: 30rem) {
    .hero {
      --photo-h: clamp(13rem, 36svh, 19rem);
    }
  }
</style>

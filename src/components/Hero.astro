---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { site, contactAnchor } from '../data/site';
import sala from '../assets/photos/casa-sala.jpg';
import mesa from '../assets/photos/ambiente-mesa.jpg';
---

<section class="hero on-paint" id="inicio" data-nav-section aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <!-- The fascia: the shop's sign board, lettered in gilt. -->
    <div class="fascia board">
      <h1 class="sign" id="hero-title">
        <span class="sign__name gilt">Monika's</span>
        <span class="sign__rest">
          <span class="sign__trade gilt">Coffee</span>
          <span class="visually-hidden">: </span>
          <span class="sign__line">{site.tagline}</span>
        </span>
      </h1>
    </div>

    <!-- The shopfront bays: a wide window and a tall door pane, set in green joinery. -->
    <div class="bays">
      <div class="bay bay--window frame frame--bead">
        <Photo
          src={sala}
          alt="La sala al atardecer: mesas de madera, sillas de bistró y plantas colgantes bañadas por una luz dorada."
          widths={[640, 960, 1280, 1600, 1800]}
          sizes="(min-width: 60rem) 62vw, (min-width: 44rem) 58vw, 100vw"
          priority
        />
        <span class="transom" aria-hidden="true"></span>
        <span class="shutter" aria-hidden="true"></span>
      </div>
      <div class="bay bay--door frame frame--bead">
        <Photo
          src={mesa}
          alt="Tres cafés con un corazón dibujado en la espuma, sobre una mesa de madera rodeada de plantas."
          widths={[240, 400, 640, 800, 1000]}
          sizes="(min-width: 60rem) 30vw, (min-width: 44rem) 40vw, 34vw"
        />
        <span class="shutter" aria-hidden="true"></span>
      </div>
    </div>

    <!-- The stallriser: the painted panel under the windows. -->
    <div class="stallriser">
      <p class="stallriser__text">
        Una cafetería pequeña para sentarse sin prisa: espressos y lattes preparados al momento,
        bebidas frías, matcha y bollería del día.
      </p>
      <div class="stallriser__actions">
        <a class="btn btn--gilt" href={`#${contactAnchor}`}>
          Escríbenos
          <Icon name="arrow" class="arrow" />
        </a>
        <a class="btn btn--line" href="#carta">Ver la carta</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--paint);
    padding-block: var(--joint) calc(var(--joint) * 2);
  }

  .hero__inner {
    display: grid;
    grid-template-rows: auto minmax(15rem, 1fr) auto;
    gap: var(--joint);
    min-height: calc(100svh - var(--header-h) - var(--joint) * 3);
  }

  /* ----- Fascia ----- */

  .fascia {
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 2.6vw, 2.25rem) clamp(1.5rem, 4vw, 3rem);
  }

  .sign {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2.5vw, 2.5rem);
    font-weight: 400;
    text-align: left;
  }

  .sign__name {
    font-family: var(--font-script);
    font-size: clamp(3.6rem, 1.6rem + 7.4vw, 8.25rem);
    line-height: 0.9;
    letter-spacing: 0;
    padding: 0.06em 0.12em 0.14em 0.02em; /* room for the script's swashes and shade */
  }

  .sign__rest {
    display: grid;
    gap: 0.55rem;
    padding-left: clamp(0.75rem, 2.5vw, 2.5rem);
    border-left: 1px solid var(--gilt-line);
  }

  .sign__trade {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: clamp(1.5rem, 0.9rem + 2.2vw, 2.9rem);
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-right: -0.28em;
  }

  .sign__line {
    font-family: var(--font-sign);
    font-weight: 500;
    font-size: clamp(0.98rem, 0.85rem + 0.45vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--on-paint);
    max-width: 19ch;
  }

  /* ----- Bays ----- */

  .bays {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--joint);
    min-height: 0;
  }

  .bay {
    min-height: 0;
  }

  .bay :global(picture),
  .bay :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bay--window :global(img) {
    object-position: 50% 62%;
  }

  .bay--door :global(img) {
    object-position: 50% 70%;
  }

  /* The transom bar: the horizontal glazing bar that splits a shop window into a top light
     and the main pane, beaded in gilt like the rest of the joinery. Wide windows only. */
  .transom {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    height: var(--joint);
    background: var(--paint);
    box-shadow:
      0 -1px 0 rgb(226 194 127 / 0.5),
      0 1px 0 rgb(226 194 127 / 0.5);
    pointer-events: none;
  }

  /* The shutter: green slats that roll up once when the page opens. Hidden by default,
     so with reduced motion (or no animation support) the windows are simply open. */
  .shutter {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      repeating-linear-gradient(
        to bottom,
        var(--paint-raised) 0 1.1rem,
        var(--paint) 1.1rem 1.2rem,
        var(--shade) 1.2rem 1.25rem
      );
    transform: translateY(-101%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shutter {
      animation: shutter-up 1.25s var(--ease-in-out) 0.35s backwards;
    }

    .bay--door .shutter {
      animation-delay: 0.55s;
    }

    .bay :global(img) {
      animation: settle 2.2s var(--ease-out) 0.35s backwards;
    }
  }

  @keyframes shutter-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-101%);
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* ----- Stallriser ----- */

  /* The sill moulding (a gilt line) sits on top of the stallriser. */
  .stallriser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    padding: clamp(1rem, 1.8vw, 1.5rem) 0 0;
    border-top: 1px solid var(--gilt-line);
  }

  .stallriser__text {
    max-width: 50ch;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.55;
    color: var(--on-paint);
  }

  .stallriser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex: none;
  }

  /* ----- Small screens: the sign stacks, the door pane steps aside ----- */

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-rows: auto minmax(13rem, 1fr) auto;
    }

    .bays {
      grid-template-columns: 3fr 2fr;
    }

    .stallriser {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Narrower windows lose the transom; phones keep both bays so coffee shows at once. */
  @media (max-width: 60rem) {
    .transom {
      display: none;
    }
  }

  @media (max-width: 44rem) {
    .bays {
      grid-template-columns: 2fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .sign {
      flex-direction: column;
      gap: 0.6rem;
      text-align: center;
    }

    .sign__rest {
      justify-items: center;
      padding-left: 0;
      padding-top: 0.6rem;
      border-left: 0;
      border-top: 1px solid var(--gilt-line);
    }

    .sign__line {
      max-width: none;
    }

    .stallriser__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>

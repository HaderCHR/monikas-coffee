---
import Photo from './Photo.astro';
import dosis from '../assets/photos/ritual-dosis.jpg';
import extraccion from '../assets/photos/ritual-extraccion.jpg';
import leche from '../assets/photos/ritual-leche.jpg';
import agua from '../assets/photos/ritual-agua.jpg';

// Four stations in a fixed order; each is registered by its real measurement.
const steps = [
  {
    measure: '18',
    unit: 'g',
    measureLabel: '18 gramos',
    title: 'Molido justo antes',
    text: 'Cada dosis se muele en el momento de prepararla. Un café molido hace una hora ya ha perdido buena parte de su aroma.',
    image: dosis,
    alt: 'Dos portafiltros sobre la barra: uno con granos de café y otro con el café recién molido.',
  },
  {
    measure: '25',
    unit: 's',
    measureLabel: '25 segundos',
    title: 'Una extracción corta',
    text: 'El espresso cae en unos veinticinco segundos: lo justo para que salga dulce y con cuerpo, sin el amargor de pasarse.',
    image: extraccion,
    alt: 'Espresso cayendo del portafiltro en un hilo dorado.',
  },
  {
    measure: '65',
    unit: '°C',
    measureLabel: '65 grados',
    title: 'Leche, nunca hervida',
    text: 'Texturizamos la leche hasta unos sesenta y cinco grados. Más caliente pierde su dulzor; así queda sedosa y se puede dibujar sobre ella.',
    image: leche,
    alt: 'Una persona vierte leche texturizada sobre un café y dibuja en la espuma.',
  },
  {
    measure: '1',
    unit: 'vaso',
    measureLabel: 'un vaso',
    title: 'Agua con cada café',
    text: 'Cada taza llega a la mesa con un vaso de agua, sin pedirlo. Limpia el paladar y marca el ritmo: aquí nadie tiene prisa.',
    image: agua,
    alt: 'Vaso de agua sobre una mesa de madera, junto a una silla, con luz de tarde.',
  },
];
---

<section class="ritual" id="ritual" data-nav-section aria-labelledby="ritual-title">
  <div class="wrap">
    <header class="ritual__head">
      <h2 class="title" id="ritual-title" data-motion="title">El ritual de cada taza</h2>
      <p class="lead">
        Cuatro gestos, siempre en el mismo orden, cada vez que alguien pide un café. Ninguno se ve
        desde la mesa, pero todos se notan en la taza.
      </p>
    </header>

    <ol class="stations" role="list">
      {
        steps.map((step, i) => (
          <li class="station">
            <p class="station__count notation" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <div class="station__photo photo">
              <Photo
                src={step.image}
                alt={step.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 100vw"
              />
            </div>
            <div class="station__text">
              <p class="station__measure">
                <span aria-hidden="true">
                  <span class="station__num" data-count={step.measure}>{step.measure}</span>
                  <span class="station__unit">{step.unit}</span>
                </span>
                <span class="visually-hidden">{step.measureLabel}</span>
              </p>
              <h3 class="station__title">{step.title}</h3>
              <p class="station__desc">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Crema, under the milk. */
  .ritual {
    --ground: var(--crema);
    --gap: clamp(1rem, 2vw, 2rem);
    padding-block: var(--section-y);
    background: linear-gradient(in oklab, var(--milk), var(--crema) calc(var(--seam) * 1.75)) var(--crema);
    color: var(--roast);
  }

  /* Title and lead stacked on the left, like the heading of a recipe card. */
  .ritual__head {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .ritual__head .lead {
    color: var(--brown);
  }

  .stations {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) var(--gap);
  }

  .station {
    display: grid;
    align-content: start;
    gap: 1.1rem;
  }

  /* One timeline across the four stations: each station carries its stretch of the rule,
     reaching over the gap to the next one. */
  .station__count {
    position: relative;
    padding-top: 0.9rem;
    color: var(--ink);
  }

  .station__count::before,
  .station__count::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
  }

  .station__count::before {
    width: calc(100% + var(--gap));
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(var(--line, 1));
  }

  .station:last-child .station__count::before {
    width: 100%;
  }

  .station__count::after {
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(var(--dot, 1));
  }

  .station__photo {
    aspect-ratio: 4 / 5;
  }

  .station__text {
    display: grid;
    gap: 0.5rem;
  }

  .station__measure {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: lining-nums;
  }

  /* The figure keeps its final width while it counts, so the unit never moves. */
  .station__num {
    display: inline-block;
    text-align: right;
  }

  .station__unit {
    font-size: 0.42em;
    font-style: italic;
    letter-spacing: 0;
    margin-left: 0.08em;
  }

  .station__title {
    font-size: var(--step-1);
  }

  .station__desc {
    font-size: 0.975rem;
  }

  @media (max-width: 64rem) {
    .stations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .station:nth-child(2) .station__count::before {
      width: 100%;
    }
  }

  @media (max-width: 40rem) {
    .stations {
      grid-template-columns: minmax(0, 1fr);
    }

    .station .station__count::before {
      width: 100%;
    }

    .station__photo {
      aspect-ratio: 16 / 11;
    }
  }
</style>

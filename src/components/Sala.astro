---
import Photo from './Photo.astro';
import salaMadera from '../assets/photos/hero-sala.jpg';
import charla from '../assets/photos/ambiente-charla.jpg';
import pastel from '../assets/photos/ambiente-pastel.jpg';
import tazaVerde from '../assets/photos/ambiente-taza-verde.jpg';
import barra from '../assets/photos/ambiente-barra.jpg';
import tazas from '../assets/photos/ambiente-tazas.jpg';

// Panes of one window, largest first. `pane` names the slot in the joinery grid.
const panes = [
  {
    pane: 'a',
    image: salaMadera,
    alt: 'Sala con mesas de madera, bancos tapizados y lámparas encendidas frente a un gran ventanal.',
    sizes: '(min-width: 44rem) 58vw, 100vw',
  },
  {
    pane: 'b',
    image: charla,
    alt: 'Dos amigas conversan y se ríen en una mesa de madera, cada una con su bebida.',
    sizes: '(min-width: 44rem) 40vw, 100vw',
  },
  {
    pane: 'c',
    image: pastel,
    alt: 'Manos sobre una mesa con un trozo de tarta, macarons y una taza de café.',
    sizes: '(min-width: 44rem) 24vw, 50vw',
  },
  {
    pane: 'd',
    image: tazaVerde,
    alt: 'Taza de cerámica verde oliva sobre su platillo, junto a un paño de lino.',
    sizes: '(min-width: 44rem) 16vw, 50vw',
  },
  {
    pane: 'e',
    image: barra,
    alt: 'Gente sentada en una cafetería amplia con barra de madera y ventanales altos.',
    sizes: '(min-width: 44rem) 40vw, 50vw',
  },
  {
    pane: 'f',
    image: tazas,
    alt: 'Tazas de café blancas, ya vacías, reunidas sobre una mesa de madera después de una larga charla.',
    sizes: '(min-width: 44rem) 58vw, 50vw',
  },
];
---

<section class="sala" id="sala" data-nav-section aria-labelledby="sala-title">
  <div class="wrap">
    <header class="sala__head">
      <h2 class="section-title" id="sala-title">La sala, a cualquier hora</h2>
      <p class="lead">
        Mesas de madera, plantas en cada rincón y una luz que cambia con el día. Así se está en
        Monika's: por la mañana con prisa amable, por la tarde con tiempo de sobra.
      </p>
    </header>

    <!-- One window, many panes: the green joinery holds the photographs together. -->
    <ul class="window" role="list" aria-label="Fotografías de la sala">
      {
        panes.map((p) => (
          <li class:list={['pane frame frame--bead frame--zoom', `pane--${p.pane}`]}>
            <Photo src={p.image} alt={p.alt} widths={[360, 560, 800, 1100, 1400]} sizes={p.sizes} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sala {
    background: var(--oat);
    padding-block: var(--section-y);
  }

  .sala__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem clamp(1.5rem, 3vw, 3rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sala__head h2 {
    grid-column: 1 / 7;
  }

  .sala__head .lead {
    grid-column: 8 / 13;
  }

  .window {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(3, clamp(9.5rem, 17vw, 16.5rem));
    gap: var(--joint);
    padding: var(--joint);
    background: var(--paint);
    box-shadow: 0 30px 60px -40px rgb(13 25 19 / 0.6);
  }

  .pane--a {
    grid-column: 1 / 8;
    grid-row: 1 / 3;
  }

  .pane--b {
    grid-column: 8 / 13;
    grid-row: 1;
  }

  .pane--c {
    grid-column: 8 / 11;
    grid-row: 2;
  }

  .pane--d {
    grid-column: 11 / 13;
    grid-row: 2;
  }

  .pane--e {
    grid-column: 1 / 6;
    grid-row: 3;
  }

  .pane--f {
    grid-column: 6 / 13;
    grid-row: 3;
  }

  .pane--b :global(img) {
    object-position: 50% 45%;
  }

  @media (max-width: 44rem) {
    .sala__head h2,
    .sala__head .lead {
      grid-column: 1 / -1;
    }

    .window {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: clamp(9rem, 38vw, 15rem);
    }

    .pane--a {
      grid-column: 1 / -1;
      grid-row: span 2;
    }

    .pane--b,
    .pane--c,
    .pane--d,
    .pane--e {
      grid-column: auto;
      grid-row: auto;
    }

    .pane--f {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>

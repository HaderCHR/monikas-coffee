---
import Photo from './Photo.astro';
import mesa from '../assets/photos/ambiente-mesa.jpg';
import pastel from '../assets/photos/ambiente-pastel.jpg';
import tazaVerde from '../assets/photos/ambiente-taza-verde.jpg';
import tazas from '../assets/photos/casa-tazas.jpg';
---

<section class="sala dark" id="sala" data-nav-section aria-labelledby="sala-title">
  <!-- The surface of the espresso: a curved edge that flattens as the room rises into view.
       Hidden unless the motion script runs. -->
  <div class="sala__meniscus" aria-hidden="true"></div>
  <div class="sala__spread wrap">
    <div class="sala__photo sala__photo--mesa photo photo--zoom" data-depth="0">
      <Photo
        src={mesa}
        alt="Tres cafés con un corazón dibujado en la espuma, sobre una mesa de madera rodeada de plantas."
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 48rem) 40vw, 100vw"
      />
    </div>

    <div class="sala__head">
      <h2 class="title" id="sala-title" data-motion="title">La sala, a{' '}cualquier{' '}hora</h2>
      <p class="lead">
        Mesas de madera, plantas en cada rincón y una luz que cambia con el día.
      </p>
    </div>

    <div class="sala__photo sala__photo--pastel photo photo--zoom" data-depth="1">
      <Photo
        src={pastel}
        alt="Manos sobre una mesa con un trozo de tarta, macarons y una taza de café."
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 64rem) 22vw, (min-width: 48rem) 42vw, 60vw"
      />
    </div>

    <div class="sala__photo sala__photo--verde photo photo--zoom" data-depth="2">
      <Photo
        src={tazaVerde}
        alt="Taza de cerámica verde oliva sobre su platillo, junto a un paño de lino."
        widths={[320, 480, 640]}
        sizes="(min-width: 64rem) 22vw, (min-width: 48rem) 32vw, 40vw"
      />
    </div>

    <p class="sala__line" data-motion="ink">Por la mañana, con prisa amable. Por la tarde, con tiempo de sobra.</p>

    <div class="sala__photo sala__photo--tazas photo photo--zoom" data-depth="0.6">
      <Photo
        src={tazas}
        alt="Dos tazas de cerámica hechas a mano, una rosada con triángulos, sobre un estante de madera."
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 48rem) 30vw, 50vw"
      />
    </div>
  </div>
</section>

<style>
  .sala {
    position: relative;
    padding-block: var(--section-y);
  }

  /* Crema hanging into the top of the room in a shallow curve: the meniscus of the espresso.
     It starts flattened (invisible) and only the motion script draws and releases it. */
  .sala__meniscus {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(2.5rem, 6vw, 6rem);
    background: var(--crema);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    transform: scaleY(0);
    transform-origin: top;
    pointer-events: none;
  }

  /* An editorial spread: photographs of different sizes and heights, the heading and one long
     line of type set between them. */
  .sala__spread {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .sala__photo--mesa {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
    aspect-ratio: 4 / 5;
  }

  .sala__head {
    grid-column: 7 / -1;
    grid-row: 1;
    align-self: end;
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(0rem, 2vw, 2rem);
  }

  /* A deliberate pair: two photographs of one size, the second set lower. */
  .sala__photo--pastel {
    grid-column: 7 / 10;
    grid-row: 2;
    aspect-ratio: 4 / 5;
  }

  .sala__photo--verde {
    grid-column: 10 / -1;
    grid-row: 2;
    aspect-ratio: 4 / 5;
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .sala__line {
    grid-column: 2 / 7;
    grid-row: 3;
    align-self: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    text-wrap: balance;
  }

  .sala__photo--tazas {
    grid-column: 8 / -1;
    grid-row: 3;
    aspect-ratio: 3 / 2;
    margin-top: clamp(1rem, 3vw, 3rem);
  }

  @media (max-width: 64rem) {
    .sala__photo--pastel {
      grid-column: 7 / -1;
    }

    .sala__photo--verde {
      grid-column: 1 / 5;
      grid-row: 3;
      margin-top: 0;
    }

    .sala__line {
      grid-column: 6 / -1;
      grid-row: 3;
    }

    .sala__photo--tazas {
      grid-column: 3 / -1;
      grid-row: 4;
      margin-top: 0;
    }
  }

  @media (max-width: 48rem) {
    .sala__spread > * {
      grid-row: auto;
    }

    .sala__head {
      grid-column: 1 / -1;
      order: -1;
      padding-bottom: 0;
    }

    .sala__photo--mesa {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3.6;
    }

    .sala__photo--pastel {
      grid-column: 1 / 8;
    }

    .sala__photo--verde {
      grid-column: 8 / -1;
      grid-row: auto;
      margin-top: 3rem;
    }

    .sala__line {
      grid-column: 1 / -1;
    }

    .sala__photo--tazas {
      grid-column: 3 / -1;
    }
  }
</style>

---
import Icon from './Icon.astro';
import { site, nav, contactAnchor } from '../data/site';
import { photographers } from '../data/credits';
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__about">
        <p class="footer__mark" aria-hidden="true">
          <span class="footer__name">Monika's</span>
          <span class="footer__trade">Coffee</span>
        </p>
        <p class="footer__tagline">Café, repostería de casa y una mesa junto a la ventana.</p>
        <p class="footer__fiction">
          Monika's Coffee es una marca ficticia creada como proyecto de portafolio. No tiene local,
          horarios ni canales de contacto reales.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Secundaria">
        <h2 class="footer__heading">En esta página</h2>
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a href={`#${item.id}`}>
                  <span class="draw">{item.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={`#${contactAnchor}`}>
              <span class="draw">Escríbenos</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="footer__credits">
        <h2 class="footer__heading">Fotografía</h2>
        <details>
          <summary>Fotos de Unsplash, de {photographers.length} fotógrafos</summary>
          <ul role="list">
            {
              photographers.map((p) => (
                <li>
                  <a href={`https://unsplash.com/@${p.handle}`} rel="noopener" target="_blank">
                    <span class="draw">{p.author}</span>
                    <span class="visually-hidden"> (abre en una pestaña nueva)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </div>

    <div class="footer__base">
      <p>© {site.year} {site.name} · Marca ficticia</p>
      <a class="footer__top" href="#inicio">
        Volver arriba
        <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--espresso-deep);
    padding-top: clamp(3.5rem, 2rem + 5vw, 6rem);
    font-size: 0.975rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 3fr) minmax(0, 3fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer__about {
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: 30rem;
  }

  .footer__mark {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    color: var(--on-dark);
    line-height: 1;
  }

  .footer__name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.75rem);
    letter-spacing: -0.025em;
  }

  .footer__trade {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--caramel);
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--on-dark);
  }

  .footer__heading {
    margin-bottom: 0.75rem;
    font-family: var(--font-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--caramel);
  }

  .footer__nav a,
  .footer__credits a {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    color: var(--on-dark);
    text-decoration: none;
    transition: color var(--t-quick) ease;
  }

  .footer__nav a:hover,
  .footer__credits a:hover {
    color: var(--caramel);
  }

  .footer__credits summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--on-dark);
    list-style: none;
  }

  .footer__credits summary::-webkit-details-marker {
    display: none;
  }

  .footer__credits summary::after {
    content: '+';
    margin-left: auto;
    color: var(--caramel);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 300ms var(--ease-out);
  }

  .footer__credits details[open] summary::after {
    transform: rotate(45deg);
  }

  /* The list of photographers opens to its height instead of appearing at once. */
  @media (prefers-reduced-motion: no-preference) {
    .footer__credits details {
      interpolate-size: allow-keywords;
    }

    .footer__credits details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 480ms var(--ease-out),
        content-visibility 480ms allow-discrete;
    }

    .footer__credits details[open]::details-content {
      block-size: auto;
    }
  }

  .footer__credits ul {
    padding-top: 0.25rem;
    columns: 2;
    column-gap: 1rem;
    font-size: 0.9rem;
  }

  .footer__credits li {
    break-inside: avoid;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--on-dark);
    text-decoration: none;
  }

  .footer__top .icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* The arrow leaves upwards and comes back from below. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .footer__top:hover .icon {
      animation: arrow-up-through 560ms var(--ease-out);
    }
  }

  @keyframes arrow-up-through {
    40% {
      transform: translateY(-120%);
      opacity: 0;
    }
    41% {
      transform: translateY(120%);
      opacity: 0;
    }
  }

  /* The page is lifted off the footer: on screens tall enough to hold it, the footer waits
     underneath (sticky at the bottom, below main) and the contact section slides away to
     uncover it. CSS only; the motion script adds a slight rise to its content. */
  @media (min-width: 48rem) and (min-height: 40rem) {
    .footer {
      position: sticky;
      bottom: 0;
      z-index: 0;
    }
  }

  @media (max-width: 56rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer__credits ul {
      columns: 1;
    }
  }
</style>

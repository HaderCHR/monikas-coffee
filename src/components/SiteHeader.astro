---
import Icon from './Icon.astro';
import { nav, contactAnchor } from '../data/site';
---

<header class="header" data-header>
  <div class="header__bar wrap">
    <a class="wordmark" href="#inicio" aria-label="Monika's Coffee, al inicio">
      <span class="wordmark__name">Monika's</span>
      <span class="wordmark__trade">Coffee</span>
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="draw" href={`#${item.id}`} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn header__cta" href={`#${contactAnchor}`} data-magnetic>Escríbenos</a>

    <button
      class="header__menu"
      type="button"
      aria-label="Abrir el menú"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-open
    >
      <Icon name="menu" />
      <span aria-hidden="true">Menú</span>
    </button>
  </div>
</header>

<dialog class="menu" id="menu" aria-label="Menú" data-menu>
  <div class="menu__inner wrap">
    <div class="menu__top">
      <span class="wordmark" aria-hidden="true">
        <span class="wordmark__name">Monika's</span>
        <span class="wordmark__trade">Coffee</span>
      </span>
      <button class="header__menu" type="button" aria-label="Cerrar el menú" data-menu-close>
        <Icon name="close" />
        <span aria-hidden="true">Cerrar</span>
      </button>
    </div>
    <nav aria-label="Menú del sitio">
      <ul class="menu__links" role="list">
        {
          nav.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn menu__cta" href={`#${contactAnchor}`}>
      Escríbenos
      <Icon name="arrow" />
    </a>
  </div>
</dialog>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--foam);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease;
  }

  .header[data-scrolled='true'] {
    border-bottom-color: var(--rule);
  }

  /* The bar arrives first and quickly: the wordmark, then the links one by one, then the call
     to action, before the room is poured in below. */
  @media (prefers-reduced-motion: no-preference) {
    .header__bar > *,
    .header__nav li {
      animation: bar-in 700ms var(--ease-out) backwards;
    }

    .header__bar > .header__nav {
      animation: none;
    }

    .header__nav li:nth-child(1) { animation-delay: 60ms; }
    .header__nav li:nth-child(2) { animation-delay: 100ms; }
    .header__nav li:nth-child(3) { animation-delay: 140ms; }
    .header__nav li:nth-child(4) { animation-delay: 180ms; }
    .header__cta,
    .header__menu { animation-delay: 240ms; }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      translate: 0 -0.6rem;
    }
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    height: var(--header-h);
  }

  /* ----- Wordmark: the name in Brygada italic, the trade in small grotesk caps ----- */

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-right: auto;
    padding-block: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
  }

  .wordmark__trade {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--coffee);
  }

  /* ----- Links: an underline draws in on hover and stays on the current section ----- */

  .header__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .header__nav a {
    --draw-y: 0.6rem;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--brown);
  }

  .header__nav a:hover,
  .header__nav a[aria-current] {
    color: var(--ink);
  }

  .header__cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
  }

  .header__menu {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    border: 0;
    background: none;
    font-weight: 600;
    color: var(--ink);
  }

  /* ----- Full-screen menu on small screens ----- */

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--foam);
    color: var(--ink);
  }

  .menu::backdrop {
    background: rgb(36 24 18 / 0.4);
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: 2rem;
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .menu__links {
    display: grid;
    margin-top: clamp(2rem, 8vh, 4rem);
    border-top: 1px solid var(--rule);
  }

  .menu__links a {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    text-decoration: none;
  }

  .menu__cta {
    margin-top: auto;
    width: 100%;
  }

  /* Opens over 320ms, closes in 200ms: the exit is quicker than the entrance. */
  .menu {
    opacity: 0;
    transition:
      opacity 200ms ease,
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  .menu[open] {
    opacity: 1;
    transition-duration: 320ms;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {

    .menu[open] .menu__links li {
      animation: menu-link 520ms var(--ease-out) backwards;
    }

    .menu[open] .menu__links li:nth-child(2) { animation-delay: 40ms; }
    .menu[open] .menu__links li:nth-child(3) { animation-delay: 80ms; }
    .menu[open] .menu__links li:nth-child(4) { animation-delay: 120ms; }
  }

  @keyframes menu-link {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (max-width: 60rem) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 22.5rem) {
    .wordmark__trade {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // --- A hairline under the bar once the page has moved.
  if (header) {
    let queued = false;
    const update = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
      queued = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // --- Current section in the navigation: the section crossing a line 40% down the screen.
  // Chosen by geometry on every observer callback, so fast jumps never leave a stale link.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-nav-section]')];
  if ('IntersectionObserver' in window && sections.length) {
    let currentId = '';
    const update = () => {
      const line = window.innerHeight * 0.4;
      const active = sections.find((s) => {
        const r = s.getBoundingClientRect();
        return r.top <= line && r.bottom > line;
      });
      const id = active?.id ?? '';
      if (id === currentId) return;
      currentId = id;
      links.forEach((link) => {
        if (link.dataset.navLink === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(update, {
      rootMargin: '-35% 0px -55% 0px',
      threshold: [0, 1],
    });
    sections.forEach((section) => observer.observe(section));
  }

  // --- Mobile menu.
  if (dialog && openBtn) {
    // Keep aria-expanded in step with the dialog however it closes (button, link, Esc).
    // Some engines fire `toggle` but not `close` for dialogs, so both are handled.
    const sync = () => openBtn.setAttribute('aria-expanded', String(dialog.open));
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      sync();
    });
    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', sync);
    dialog.addEventListener('toggle', sync);
    // Following a link closes the menu; the browser then scrolls to the anchor.
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
    // Leaving the small-screen layout with the menu open closes it.
    matchMedia('(min-width: 60.0625rem)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

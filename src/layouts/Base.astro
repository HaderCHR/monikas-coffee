---
import { Font } from 'astro:assets';
import { site, base } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Pages that should not appear in search results (the 404). */
  noindex?: boolean;
}

const { title = site.title, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og-image.jpg`, Astro.site).href;

// Minimal, truthful structured data: it names the website only. No LocalBusiness/CafeOrCoffeeShop
// schema on purpose, because the café is fictional and has no address, hours or reviews to describe.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL(base, Astro.site).href,
  inLanguage: site.lang,
  description: site.description,
});
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portada de Monika's Coffee: la sala con luz de tarde y una tarjeta con el lema «Café recién hecho y repostería de casa, para quedarse un rato»." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { base } from '../data/site';
---

<Base title="Página no encontrada · Monika's Coffee" noindex>
  <main class="lost" id="contenido" tabindex="-1">
    <div class="lost__card">
      <p class="lost__code" aria-hidden="true">404</p>
      <h1 class="lost__title">Esta mesa no existe</h1>
      <p class="lost__text">
        La página que buscas no está en la carta. Vuelve al inicio y te buscamos un buen sitio junto
        a la ventana.
      </p>
      <a class="btn" href={base}>Volver a Monika's Coffee</a>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--gutter);
    background: var(--foam);
  }

  .lost__card {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 36rem;
    padding: clamp(2rem, 6vw, 3.5rem);
    background: var(--milk);
    border-radius: 4px;
    box-shadow: 0 28px 56px -32px rgb(36 24 18 / 0.45);
  }

  .lost__code {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    line-height: 1;
    color: var(--coffee);
  }

  .lost__title {
    font-size: var(--step-3);
  }

  .lost__text {
    max-width: 42ch;
  }
</style>
